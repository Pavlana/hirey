{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python3 -m prep.cli queue 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
