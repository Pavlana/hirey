{
  "about": "Which doc pages own which code. python -m prep.docs_check --changed BASE fails when code in a rule changed but none of its docs did, unless the pull request says 'Docs: not needed, <reason>'. Patterns are fnmatch globs from the repository root ('*' also crosses '/').",
  "ignore": ["prep/__init__.py", "*/__pycache__/*", "*.pyc"],
  "rules": [
    {"name": "Dashboard pages and routes", "code": ["prep/web.py", "prep/decision.py"],
     "docs": ["docs/reference/*.md", "docs/how-it-works.md", "docs/usage.md"]},
    {"name": "Dashboard look and behaviour", "code": ["prep/static/*"],
     "docs": ["docs/reference/*.md", "docs/screenshots/*", "docs/usage.md"]},
    {"name": "Database", "code": ["prep/db.py"],
     "docs": ["docs/reference/database.md", "docs/how-it-works.md"]},
    {"name": "Configuration", "code": ["prep/config.py", "config/settings.example.toml", "launchd/*"],
     "docs": ["docs/reference/configuration.md"]},
    {"name": "Commands", "code": ["prep/cli.py"],
     "docs": ["docs/usage.md", "CLAUDE.md", "docs/reference/*.md"]},
    {"name": "Assistants, router and workers", "code": ["prep/assistant.py", "prep/workers.py"],
     "docs": ["docs/reference/assistants.md", "docs/how-it-works.md"]},
    {"name": "Applications, research and getjo", "code": ["prep/research.py", "prep/getjo.py"],
     "docs": ["docs/reference/research.md", "docs/reference/applications.md", "docs/how-it-works.md"]},
    {"name": "CVs", "code": ["prep/cvfile.py", "prep/cvpdf.py", "prep/cv_template.html", "prep/cvcheck.py", "prep/cveval.py",
              "prep/cvedit.py", "prep/tailorplan.py"],
     "docs": ["docs/reference/cvs.md", "docs/screenshots/*"]},
    {"name": "Learn", "code": ["prep/learn.py", "prep/learnnotes.py", "prep/explainers.py", "prep/md.py"],
     "docs": ["docs/reference/learn.md", "docs/learn-format.md"]},
    {"name": "Evals page", "code": ["prep/evals.py"],
     "docs": ["docs/reference/evals.md"]},
    {"name": "Search: gate, ranking, Top 5", "code": ["prep/criteria.py", "prep/search.py", "criteria.example.md"],
     "docs": ["docs/reference/search.md", "docs/how-it-works.md"]},
    {"name": "Pipeline stats", "code": ["prep/stats.py", "prep/charts.py"],
     "docs": ["docs/reference/metrics.md"]},
    {"name": "Privacy rules", "code": ["prep/privacy.py", "scripts/pre-commit"],
     "docs": ["docs/how-it-works.md", "docs/reference/configuration.md", "CLAUDE.md"]},
    {"name": "Example data", "code": ["prep/seed_example.py"],
     "docs": ["docs/usage.md", "docs/reference/*.md", "docs/screenshots/*"]},
    {"name": "Docs tooling", "code": ["prep/docs_check.py", "docs/docs-map.json", ".github/workflows/*", "scripts/screenshots.py"],
     "docs": ["docs/reference/README.md", "CLAUDE.md"]},
    {"name": "Skills: Applications Assistant and Comms", "code": [".claude/skills/ask/*", ".claude/skills/reply/*", ".claude/skills/today/*"],
     "docs": ["docs/reference/assistants.md", "docs/usage.md"]},
    {"name": "Skills: applications", "code": [".claude/skills/applied/*", ".claude/skills/stage/*", ".claude/skills/task/*"],
     "docs": ["docs/reference/applications.md", "docs/usage.md"]},
    {"name": "Skills: research and CVs", "code": [".claude/skills/research/*"],
     "docs": ["docs/reference/research.md", "docs/reference/cvs.md"]},
    {"name": "Skills: practice", "code": [".claude/skills/debrief/*"],
     "docs": ["docs/reference/practice.md"]},
    {"name": "Skills: Learn", "code": [".claude/skills/learn-ask/*", ".claude/skills/explainer/*"],
     "docs": ["docs/reference/learn.md"]},
    {"name": "Skill: docs sync", "code": [".claude/skills/docs-sync/*"],
     "docs": ["docs/reference/README.md", "CLAUDE.md"]}
  ]
}
